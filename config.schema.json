{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "maxPageBytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 1048576,
      "default": 1048576,
      "title": "Maximale Seitengröße (Bytes)"
    },
    "archiveRetentionDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650,
      "default": 90,
      "title": "Archivaufbewahrung (Tage)"
    },
    "allowUserEditing": {
      "type": "boolean",
      "default": true,
      "title": "Benutzer dürfen bearbeiten"
    }
  }
}
